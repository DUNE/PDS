{
    "dry_run": false,
    "plan_only": false,
    "mode": "attscan",
    "scan": {
        "attenuators": {
            "min": 2200,
            "max": 2000,
            "step": -50
        },
        "mask_values": [8]
    },
    "commands": {
        "web_proxy_cmd": "source ~np04daq/bin/web_proxy.sh -u",
        "dts_align_cmd": "dtsbutler -c /nfs/sw/dunedaq/timing/connections.xml mst GIB align apply-delay 0x20 0 0 --force -m 3",
        "dts_faketrig_cmd_template": "dtsbutler -c /nfs/sw/dunedaq/timing/connections.xml mst GIB faketrig-conf 0x7 0 {hztrigger} --poisson ",
        "dts_clear_fktrig_cmd": "dtsbutler -c /nfs/sw/dunedaq/timing/connections.xml mst GIB faketrig-clear 0"
    },
    "paths": {
        "drunc_working_dir": "/nfs/sw/dunedaq/dunedaq-fddaq-v5.5.0-rc2-dev-pds",
        "oks_file": "ehn1-daqconfigs/segments/pds-vst.data.xml",
        "oks_session": "ehn1-daqconfigs/sessions/pds-vst-session.xml",
        "session_name": "np02-session",
        "daphne_details": "pds/configs/vst/detail_mezz_fe_v2.json",
        "drunc_target": "pds-vst"
    },
    "daphne_obj": "daphne_mezz",
    "hztrigger": 6260.02,
    "change_rate": 20.0,
    "wait_time": 60,
    "drunc_delay_s": 20,
    "skip_proxy": true,
    "skip_ssp_conf": false,
    "skip_daphne_conf": false,
    "skip_dts": true,
    "ssp_conf": {
        "object_name": "np02-ssp-on",
        "channel_mask": "4",
        "number_channels": "12",
        "pulse_mode": "single",
        "burst_count": "1",
        "double_pulse_delay_ticks": "4000",
        "pulse1_width_ticks": "1",
        "pulse2_width_ticks": "1",
        "pulse_bias_percent_270nm": "4095",
        "pulse_bias_percent_367nm": "0"
    }
}
